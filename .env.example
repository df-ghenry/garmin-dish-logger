# Google Gemini API Key (get one free at https://aistudio.google.com/apikey)
# Can also be configured directly in the web app's Settings modal.
GEMINI_API_KEY=

# Preferred Gemini Vision model (gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Garmin credentials (only needed if ~/.garmin-mcp/ tokens are not present)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Server port (defaults to 3456)
PORT=3456
